{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ZARA Standard Server Architecture",
  "version": "1.0.0",
  "description": "Production Discord server configuration managed by ZARA (ZerXeus Autonomous Role & Administration)",
  "roles": [
    {
      "name": "Executive",
      "color": "#9B59B6",
      "hoist": true,
      "mentionable": true,
      "permissions": [
        "administrator"
      ]
    },
    {
      "name": "Administrator",
      "color": "#E74C3C",
      "hoist": true,
      "mentionable": true,
      "permissions": [
        "manage_guild",
        "manage_roles",
        "manage_channels",
        "kick_members",
        "ban_members",
        "view_audit_log",
        "manage_messages",
        "manage_nicknames",
        "manage_emojis_and_stickers",
        "manage_webhooks",
        "manage_threads",
        "mute_members",
        "deafen_members",
        "move_members",
        "view_channel",
        "send_messages",
        "embed_links",
        "attach_files",
        "read_message_history",
        "mention_everyone",
        "add_reactions",
        "connect",
        "speak"
      ]
    },
    {
      "name": "Moderator",
      "color": "#E67E22",
      "hoist": true,
      "mentionable": true,
      "permissions": [
        "kick_members",
        "ban_members",
        "manage_messages",
        "manage_nicknames",
        "manage_threads",
        "mute_members",
        "deafen_members",
        "move_members",
        "view_audit_log",
        "view_channel",
        "send_messages",
        "embed_links",
        "attach_files",
        "read_message_history",
        "add_reactions",
        "connect",
        "speak"
      ]
    },
    {
      "name": "Developer",
      "color": "#3498DB",
      "hoist": true,
      "mentionable": false,
      "permissions": [
        "view_channel",
        "send_messages",
        "send_messages_in_threads",
        "create_public_threads",
        "create_private_threads",
        "embed_links",
        "attach_files",
        "read_message_history",
        "add_reactions",
        "use_external_emojis",
        "use_external_stickers",
        "connect",
        "speak"
      ]
    },
    {
      "name": "VIP",
      "color": "#F1C40F",
      "hoist": true,
      "mentionable": false,
      "permissions": [
        "view_channel",
        "send_messages",
        "embed_links",
        "attach_files",
        "read_message_history",
        "add_reactions",
        "use_external_emojis",
        "priority_speaker",
        "connect",
        "speak"
      ]
    },
    {
      "name": "Bot",
      "color": "#1ABC9C",
      "hoist": true,
      "mentionable": false,
      "permissions": [
        "view_channel",
        "send_messages",
        "manage_messages",
        "embed_links",
        "attach_files",
        "read_message_history",
        "add_reactions",
        "use_external_emojis",
        "use_application_commands"
      ]
    },
    {
      "name": "Member",
      "color": "#2ECC71",
      "hoist": false,
      "mentionable": false,
      "permissions": [
        "view_channel",
        "send_messages",
        "send_messages_in_threads",
        "read_message_history",
        "add_reactions",
        "connect",
        "speak",
        "use_voice_activation",
        "change_nickname"
      ]
    },
    {
      "name": "@everyone",
      "color": "#000000",
      "hoist": false,
      "mentionable": false,
      "permissions": [
        "view_channel",
        "send_messages",
        "read_message_history",
        "add_reactions",
        "connect",
        "speak",
        "use_voice_activation"
      ]
    }
  ],
  "categories": [
    {
      "name": "📌 INFORMATION",
      "overwrites": {
        "@everyone": {
          "view_channel": true,
          "send_messages": false,
          "add_reactions": true,
          "read_message_history": true
        },
        "Moderator": {
          "send_messages": true,
          "manage_messages": true
        },
        "Administrator": {
          "send_messages": true,
          "manage_messages": true
        },
        "Executive": {
          "send_messages": true,
          "manage_messages": true
        }
      },
      "channels": [
        {
          "name": "rules-and-info",
          "type": "text",
          "topic": "Welcome to the server! Please read the rules and guidelines carefully.",
          "slowmode_delay": 0
        },
        {
          "name": "announcements",
          "type": "announcement",
          "topic": "Official server announcements and project news.",
          "slowmode_delay": 0
        },
        {
          "name": "resources-and-links",
          "type": "text",
          "topic": "Curated resources, documentation, and useful links.",
          "slowmode_delay": 0
        },
        {
          "name": "role-selection",
          "type": "text",
          "topic": "Select your notification and interest roles here.",
          "slowmode_delay": 0
        }
      ]
    },
    {
      "name": "💬 GENERAL CHAT",
      "overwrites": {
        "@everyone": {
          "view_channel": true,
          "send_messages": true,
          "read_message_history": true,
          "attach_files": true,
          "embed_links": true
        }
      },
      "channels": [
        {
          "name": "general",
          "type": "text",
          "topic": "General discussions and casual conversation.",
          "slowmode_delay": 0
        },
        {
          "name": "introductions",
          "type": "text",
          "topic": "Introduce yourself to the community!",
          "slowmode_delay": 5
        },
        {
          "name": "media-and-showcase",
          "type": "text",
          "topic": "Share your screenshots, art, and creative works.",
          "slowmode_delay": 10
        },
        {
          "name": "bot-commands",
          "type": "text",
          "topic": "Execute bot commands here to keep other channels clean.",
          "slowmode_delay": 3
        }
      ]
    },
    {
      "name": "💻 DEVELOPMENT & ENGINEERING",
      "overwrites": {
        "@everyone": {
          "view_channel": true,
          "send_messages": true,
          "read_message_history": true
        }
      },
      "channels": [
        {
          "name": "dev-general",
          "type": "text",
          "topic": "Architecture, code reviews, and programming discussions.",
          "slowmode_delay": 0
        },
        {
          "name": "github-feed",
          "type": "text",
          "topic": "Automated repository commit and release notifications.",
          "slowmode_delay": 0,
          "overwrites": {
            "@everyone": {
              "send_messages": false
            }
          }
        },
        {
          "name": "bug-reports",
          "type": "text",
          "topic": "Report bugs, issues, and feature requests.",
          "slowmode_delay": 15
        }
      ]
    },
    {
      "name": "🔊 VOICE CHANNELS",
      "overwrites": {
        "@everyone": {
          "view_channel": true,
          "connect": true,
          "speak": true
        }
      },
      "channels": [
        {
          "name": "Lounge 1",
          "type": "voice",
          "user_limit": 0,
          "bitrate": 64000
        },
        {
          "name": "Lounge 2",
          "type": "voice",
          "user_limit": 0,
          "bitrate": 64000
        },
        {
          "name": "Focus Room (Duo)",
          "type": "voice",
          "user_limit": 2,
          "bitrate": 96000
        },
        {
          "name": "Squad Room (5 Max)",
          "type": "voice",
          "user_limit": 5,
          "bitrate": 96000
        }
      ]
    },
    {
      "name": "🛡️ STAFF & OPERATIONS",
      "overwrites": {
        "@everyone": {
          "view_channel": false
        },
        "Moderator": {
          "view_channel": true,
          "send_messages": true,
          "read_message_history": true,
          "manage_messages": true
        },
        "Administrator": {
          "view_channel": true,
          "send_messages": true,
          "read_message_history": true,
          "manage_messages": true,
          "manage_channels": true
        },
        "Executive": {
          "view_channel": true,
          "send_messages": true,
          "read_message_history": true,
          "manage_messages": true,
          "manage_channels": true
        }
      },
      "channels": [
        {
          "name": "staff-chat",
          "type": "text",
          "topic": "Internal staff discussions and coordination.",
          "slowmode_delay": 0
        },
        {
          "name": "bot-actions-log",
          "type": "text",
          "topic": "Automated log of all moderation and administrative commands executed via ZARA.",
          "slowmode_delay": 0
        },
        {
          "name": "server-events-log",
          "type": "text",
          "topic": "Real-time audit log of server events (member joins/leaves, message edits/deletions, voice activity).",
          "slowmode_delay": 0
        },
        {
          "name": "mod-audit-logs",
          "type": "text",
          "topic": "Automated security alerts and moderation actions log.",
          "slowmode_delay": 0
        },
        {
          "name": "bot-testing-lab",
          "type": "text",
          "topic": "Staging and experimental bot command testing.",
          "slowmode_delay": 0
        },
        {
          "name": "Staff Meeting Room",
          "type": "voice",
          "user_limit": 10,
          "bitrate": 96000
        }
      ]
    },
    {
      "name": "📦 ARCHIVE",
      "overwrites": {
        "@everyone": {
          "view_channel": true,
          "send_messages": false,
          "read_message_history": true
        }
      },
      "channels": [
        {
          "name": "old-announcements",
          "type": "text",
          "topic": "Archived announcements and historical updates.",
          "slowmode_delay": 0
        },
        {
          "name": "past-events",
          "type": "text",
          "topic": "Records and archives of past community events.",
          "slowmode_delay": 0
        }
      ]
    }
  ]
}
