# ==============================================================================
# ZARA (ZerXeus's Autonomous Role & Administration System)
# Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the '.env' file to your Git repository!

# Discord Bot Token obtained from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Target Discord Server (Guild) ID where resources will be provisioned
# (Enable Developer Mode in Discord, right-click your server icon, and select 'Copy Server ID')
DISCORD_GUILD_ID=123456789012345678
